{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8x8.org/protocol/schemas/node-consent.v0.1.json",
  "title": "8x8 Node Resource Consent v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "consent_id",
    "node_id",
    "resource_class",
    "purpose",
    "workload_classes",
    "issued_at",
    "activates_at",
    "expires_at",
    "status",
    "limits",
    "allowed_coordinators",
    "data_classification",
    "reward_participation",
    "local_pause_required",
    "kill_switch_required",
    "policy_digest",
    "receipt_sink",
    "user_approval_receipt"
  ],
  "properties": {
    "schema": {
      "const": "8x8.node-consent.v0.1"
    },
    "consent_id": {
      "type": "string",
      "pattern": "^CONSENT[.][A-Za-z0-9._:-]{8,160}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^NODE[.][A-Za-z0-9._:-]{4,160}$"
    },
    "resource_class": {
      "enum": [
        "CPU",
        "GPU",
        "STORAGE",
        "BANDWIDTH",
        "TELEMETRY",
        "REMOTE_MINER_MANAGEMENT",
        "PRECISE_LOCATION",
        "REWARDS"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1000
    },
    "workload_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "activates_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "enum": ["PENDING", "ACTIVE", "PAUSED", "REVOKED", "EXPIRED"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_duration_seconds", "schedule", "network_policy"],
      "properties": {
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_cpu_percent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "max_gpu_percent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "max_storage_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "max_upload_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "max_download_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "minimum_battery_percent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "maximum_temperature_celsius": {
          "type": ["number", "null"],
          "minimum": -40,
          "maximum": 120
        },
        "schedule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "network_policy": {
          "enum": ["ANY_USER_APPROVED", "UNMETERED_ONLY", "OFFLINE_ONLY", "DENY_NETWORK"]
        }
      }
    },
    "allowed_coordinators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "allowed_destinations": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "default": []
    },
    "data_classification": {
      "enum": ["PUBLIC", "USER_GENERATED_NON_SENSITIVE", "ENCRYPTED_PROTOCOL_DATA", "NO_USER_DATA"]
    },
    "retention_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31536000,
      "default": 0
    },
    "reward_participation": {
      "enum": ["NONE", "SIMULATED", "MEASURED_UNPRICED", "OFFCHAIN_ELIGIBLE"]
    },
    "secret_reference_ids": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SECRETREF[.][A-Za-z0-9._:-]{4,160}$"
      },
      "default": []
    },
    "local_pause_required": {
      "const": true
    },
    "kill_switch_required": {
      "const": true
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_sink": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "user_approval_receipt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
