{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8x8.org/schemas/release/8x8-release-unit-v1.schema.json",
  "title": "8x8 Progressive Release Unit V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_unit_id",
    "name",
    "scope_basis_points",
    "truth_state",
    "score",
    "public_safe",
    "dependencies",
    "artifacts",
    "gates",
    "target",
    "rollback"
  ],
  "properties": {
    "schema_version": {"const": "8x8.release-unit.v1"},
    "release_unit_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "maxLength": 2000},
    "scope_basis_points": {"type": "integer", "minimum": 1, "maximum": 10000},
    "truth_state": {
      "enum": [
        "PLANNED",
        "IMPLEMENTED",
        "TESTED",
        "RECEIPT_VERIFIED",
        "RELEASE_ELIGIBLE",
        "DEPLOYED",
        "PUBLICLY_RELEASED",
        "STALE",
        "BLOCKED",
        "REVOKED"
      ]
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earned", "possible", "evaluator_version", "evidence_digest"],
      "properties": {
        "earned": {"type": "integer", "minimum": 0, "maximum": 100},
        "possible": {"const": 100},
        "evaluator_version": {"type": "string", "minLength": 1},
        "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "public_safe": {"type": "boolean"},
    "privacy_class": {"enum": ["PUBLIC", "PUBLIC_SANITIZED", "PRIVATE", "OWNER_ONLY"]},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["release_unit_id", "required_state"],
        "properties": {
          "release_unit_id": {"type": "string"},
          "required_state": {"enum": ["TESTED", "RECEIPT_VERIFIED", "DEPLOYED", "PUBLICLY_RELEASED"]}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "media_type"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string", "minLength": 1},
          "sbom_reference": {"type": ["string", "null"]},
          "provenance_reference": {"type": ["string", "null"]}
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests_pass",
        "security_pass",
        "privacy_pass",
        "accessibility_pass",
        "rollback_pass",
        "dependency_pass",
        "exact_target_resolved"
      ],
      "properties": {
        "tests_pass": {"type": "boolean"},
        "security_pass": {"type": "boolean"},
        "privacy_pass": {"type": "boolean"},
        "accessibility_pass": {"type": "boolean"},
        "rollback_pass": {"type": "boolean"},
        "dependency_pass": {"type": "boolean"},
        "exact_target_resolved": {"type": "boolean"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "identifier", "visibility"],
      "properties": {
        "class": {"enum": ["LOCAL_PREVIEW", "AUTHENTICATED_PREVIEW", "PUBLIC_STATIC", "PUBLIC_SERVICE", "MOBILE_BETA", "PRIVATE_WORLD", "PUBLIC_WORLD"]},
        "identifier": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["LOCAL", "PRIVATE", "INVITED", "PUBLIC"]},
        "region": {"type": ["string", "null"]},
        "budget_ceiling_usd": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "tested", "receipt_id"],
      "properties": {
        "strategy": {"type": "string", "minLength": 1},
        "tested": {"type": "boolean"},
        "receipt_id": {"type": ["string", "null"]}
      }
    },
    "released_at": {"type": ["string", "null"], "format": "date-time"},
    "release_receipt_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"truth_state": {"enum": ["RELEASE_ELIGIBLE", "DEPLOYED", "PUBLICLY_RELEASED"]}}},
      "then": {
        "properties": {
          "public_safe": {"const": true},
          "score": {"properties": {"earned": {"const": 100}}},
          "gates": {
            "properties": {
              "tests_pass": {"const": true},
              "security_pass": {"const": true},
              "privacy_pass": {"const": true},
              "accessibility_pass": {"const": true},
              "rollback_pass": {"const": true},
              "dependency_pass": {"const": true},
              "exact_target_resolved": {"const": true}
            }
          },
          "rollback": {"properties": {"tested": {"const": true}}}
        }
      }
    },
    {
      "if": {"properties": {"truth_state": {"enum": ["DEPLOYED", "PUBLICLY_RELEASED"]}}},
      "then": {
        "required": ["released_at", "release_receipt_id"],
        "properties": {
          "released_at": {"type": "string", "format": "date-time"},
          "release_receipt_id": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
