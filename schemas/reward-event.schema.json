{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8x8.org/protocol/schemas/reward-event.v0.1.json",
  "title": "8x8 Contribution Reward Event v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reward_event_id",
    "node_id",
    "resource_receipt_ids",
    "stage",
    "unit",
    "quantity",
    "created_at",
    "jurisdiction",
    "compliance_gate",
    "guaranteed_value",
    "investment_claim",
    "event_digest"
  ],
  "properties": {
    "schema": {
      "const": "8x8.reward-event.v0.1"
    },
    "reward_event_id": {
      "type": "string",
      "pattern": "^REWARD[.][A-Za-z0-9._:-]{8,160}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^NODE[.][A-Za-z0-9._:-]{4,160}$"
    },
    "resource_receipt_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^RECEIPT[.][A-Za-z0-9._:-]{8,160}$"
      }
    },
    "stage": {
      "enum": [
        "SIMULATED",
        "MEASURED_UNPRICED",
        "OFFCHAIN_PENDING",
        "OFFCHAIN_FINAL",
        "ONCHAIN_PENDING",
        "ONCHAIN_SETTLED"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "finalized_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "compliance_gate": {
      "enum": ["NOT_REQUIRED_FOR_SIMULATION", "PENDING", "PASSED", "BLOCKED"]
    },
    "asset_reference": {
      "type": ["string", "null"],
      "maxLength": 200
    },
    "transaction_reference": {
      "type": ["string", "null"],
      "maxLength": 300
    },
    "guaranteed_value": {
      "const": false
    },
    "investment_claim": {
      "const": false
    },
    "dispute_status": {
      "enum": ["NONE", "OPEN", "RESOLVED", "REVERSED"],
      "default": "NONE"
    },
    "event_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {"const": "ONCHAIN_SETTLED"}
        }
      },
      "then": {
        "required": ["asset_reference", "transaction_reference", "finalized_at"],
        "properties": {
          "compliance_gate": {"const": "PASSED"},
          "asset_reference": {"type": "string", "minLength": 1},
          "transaction_reference": {"type": "string", "minLength": 8},
          "finalized_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {"const": "SIMULATED"}
        }
      },
      "then": {
        "properties": {
          "compliance_gate": {"const": "NOT_REQUIRED_FOR_SIMULATION"},
          "asset_reference": {"type": "null"},
          "transaction_reference": {"type": "null"}
        }
      }
    }
  ]
}
