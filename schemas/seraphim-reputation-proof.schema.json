{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8x8.org/protocol/schemas/seraphim-reputation-proof.v0.1.json",
  "title": "Seraphim Reputation Proof v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","credential_id","subject_id","issuer_id","issued_at","expires_at",
    "policy_digest","evidence_proof_ids","reputation_domains","guardian_roles",
    "transferable","saleable","swappable","revocable","revocation_state",
    "authority_expansion_allowed","financial_authority","credential_digest"
  ],
  "properties": {
    "schema": {"const":"8x8.seraphim-reputation-proof.v0.1"},
    "credential_id": {"type":"string","pattern":"^SRP[.][A-Za-z0-9._:-]{8,200}$"},
    "subject_id": {"type":"string","pattern":"^SERAPHIM[.][A-Za-z0-9._:-]{4,200}$"},
    "issuer_id": {"type":"string","minLength":1,"maxLength":300},
    "issued_at": {"type":"string","format":"date-time"},
    "expires_at": {"type":"string","format":"date-time"},
    "policy_digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "evidence_proof_ids": {
      "type":"array","minItems":1,"maxItems":500,"uniqueItems":true,
      "items":{"type":"string","pattern":"^PROOF[.][A-Za-z0-9._:-]{8,200}$"}
    },
    "reputation_domains": {
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"enum":["SECURITY_REVIEW","PROOF_VERIFICATION","INCIDENT_RESPONSE","ANOMALY_DETECTION","POLICY_COMPLIANCE"]}
    },
    "guardian_roles": {
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"enum":["REVIEWER","CHALLENGER","INCIDENT_GUARDIAN","QUORUM_PARTICIPANT"]}
    },
    "transferable": {"const":false},
    "saleable": {"const":false},
    "swappable": {"const":false},
    "revocable": {"const":true},
    "revocation_state": {"enum":["ACTIVE","SUSPENDED","REVOKED","EXPIRED"]},
    "authority_expansion_allowed": {"const":false},
    "financial_authority": {"const":false},
    "credential_digest": {"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
